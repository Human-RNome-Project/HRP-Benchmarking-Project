# $Id$
use strict;
use warnings;
# usage: gzip -dc <GB_DIR>/*.gb.gz | annotPileupRev <bam> [genome.fa.gz]
# the genome FASTA can also come from the GENOME_FA_GZ environment variable
my $bam = shift @ARGV;
die "usage: $0 <bam> [genome.fa.gz] < records.gb\n" unless defined $bam;
my $fa = $ENV{GENOME_FA_GZ} || "/home/h/OneDrive/Unil/data/b38/b38.fa.gz";
$fa = shift @ARGV if @ARGV && $ARGV[0] !~ /\.gb$/;
die "Genome FASTA not found: $fa (set GENOME_FA_GZ or pass it as 2nd argument)\n" unless -s $fa;
my $name;
my $seq;
my $len;
my @P;
my @M;
local *FD;
print "chr\tpos\tnt\tnbA\tnbG\tnbA+G\tnbStart\tnbStop\tkind\taa\tframe\tcontext\tdonor\tacceptor\tgene\n";
while ( <> ) {
  if (/^LOCUS\s+\w+\s+(\d+) bp/) {
    $len = $1;
    if (defined $name) {
      # do the pileup and annotate
      &annotate;
    }
    undef $name;
    undef $seq;
    undef @P;
    undef @M;
    next;
  }
  if (/^DEFINITION\s+.* chromosome ([^.,]+)[,.]/) {
    $name = "chr" . $1;
    print STDERR "Loading sequence $name\n";
    open FD, "gzip -dc $fa |" or die "Can't read $fa fasta file : $!";
    while ( <FD> ) {
      if (/^>(\S+)/) {
	if ($name eq $1) {
	  $seq = "";
	  while ( <FD> ) {
	    last if /^>/;
	    s/\s+//gs;
	    $seq .= uc;
	  }
	  last;
	}
      }
    }
    close FD;
    die "Couldn't load seq $name" unless defined $seq;
    $len = length $seq;
    next;
  }
  next unless /^FEATURES/;
  my $cur;
  while ( <> ) {
    last if /^\S/;
    s/\s+$//s;
    if (/^     \S/) {
      &analyze($cur) if defined $cur;
      s/^\s+//;
      $cur = $_;
      next;
    }
    $cur .= " " unless $cur =~ /,$/ or $cur =~ /\/translation="/;
    s/^\s+//;
    $cur .= $_;
  }
  &analyze($cur) if defined $cur;
}
if (defined $name) {
  # do the pileup and annotate
  &annotate;
}
exit 0;

