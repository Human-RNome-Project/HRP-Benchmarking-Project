sub annotate {
  # look at genes on the forward strand
  #open FD, "samtools mpileup -B -x -r $name --ff UNMAP,SECONDARY,QCFAIL,DUP,REVERSE -f /data6/dm6/dm6.fa.gz BIX/outstitch/S2R/S2R.dm6.align.sorted.dedup.flt.bam |" or die "Can't open bam file : $!";
  open FD, "samtools mpileup -B -x -r $name --ff UNMAP,SECONDARY,QCFAIL,DUP --rf REVERSE -f $fa $bam |" or die "Can't open bam file $bam : $!";
  while ( <FD> ) {
    my @F = split /\t/;
    next if uc($F[2]) ne "A";
    my $nbStart = 0;
    my $nbStop = 0;
    my $nbA = 0;
    my $nbG = 0;
    my $i = 0;
    while ($i < length($F[4])) {
      my $c = substr $F[4], $i, 1;
      if ($c eq "^") {# read start
	$nbStart += 1;
	$i += 1; # skip [
      } elsif ($c eq "\$") {# read end
	$nbStop += 1;
      } elsif ($c eq ">" || $c eq "<" || $c eq "*" || $c eq "#") {
	# nothing to do here
      } elsif ($c eq ".") {# match in forward strand
	die "Unexpected match in fwd at $_";
      } elsif ($c eq ",") {# match in reverse strand
	$nbA += 1;
      } elsif ($c =~ /[ATCGN]/) {# mismatch in forward strand
	die "Unexpected mismatch in fwd at $_";
      } elsif ($c =~ /[atcgn]/) {# mismatch in reverse strand
	$nbG += 1 if $c eq "g";
      } elsif ($c eq "+") {# insertion - ,+2cc,
	my $ds = $i + 1;
	$i += 2;
	my $c2 = substr $F[4], $i, 1;
	while ($c2 =~ /\d/) {
	  $i += 1;
	  $c2 = substr $F[4], $i, 1;
	}
	my $nb = substr $F[4], $ds, $i - $ds;
	$i += $nb - 1;
      } elsif ($c eq "-") {# deletion - ,-2ta,
	my $ds = $i + 1;
	$i += 2;
	my $c2 = substr $F[4], $i, 1;
	while ($c2 =~ /\d/) {
	  $i += 1;
	  $c2 = substr $F[4], $i, 1;
	}
	my $nb = substr $F[4], $ds, $i - $ds;
	$i += $nb - 1;
      } else {
	die "Unkown read base: $c";
      }
      $i += 1;
    }
    next unless $nbA + $nbG >= 10;
    my @A = ( $F[0], $F[1], uc($F[2]), $nbA, $nbG, $nbA + $nbG, $nbStart, $nbStop );
    if (defined $P[$F[1] - 1]) {
      my $h = $P[$F[1] - 1];
      for my $s ( 'kind', 'aa', 'frame', 'context', 'donor', 'acceptor', 'gene' ) {
	if (defined $h->{$s}) {
	  push @A, $h->{$s};
	} else {
	  push @A, "NA";
	}
      }
    } else {
      push @A, "NA", "NA", "NA", "NA", "NA", "NA", "NA";
    }
    print join("\t", @A), "\n";
  }
  close FD;
  # look at genes on the reverse strand
  #open FD, "samtools mpileup -B -x -r $name --ff UNMAP,SECONDARY,QCFAIL,DUP --rf REVERSE -f /data6/dm6/dm6.fa.gz BIX/outstitch/S2R/S2R.dm6.align.sorted.dedup.flt.bam |" or die "Can't open bam file : $!";
  open FD, "samtools mpileup -B -x -r $name --ff UNMAP,SECONDARY,QCFAIL,DUP,REVERSE -f $fa $bam |" or die "Can't open bam file $bam : $!";
  while ( <FD> ) {
    my @F = split /\t/;
    next if uc($F[2]) ne "T";
    my $nbStart = 0;
    my $nbStop = 0;
    my $nbA = 0;
    my $nbG = 0;
    my $i = 0;
    while ($i < length($F[4])) {
      my $c = substr $F[4], $i, 1;
      if ($c eq "^") {# read start
	$nbStart += 1;
	$i += 1; # skip [
      } elsif ($c eq "\$") {# read end
	$nbStop += 1;
      } elsif ($c eq ">" || $c eq "<" || $c eq "*" || $c eq "#") {
	# nothing to do here
      } elsif ($c eq ".") {# match in forward strand
	$nbA += 1;
      } elsif ($c eq ",") {# match in reverse strand
	die "Unexpected match in rev at $_";
      } elsif ($c =~ /[ATCGN]/) {# mismatch in forward strand
	$nbG += 1 if $c eq "C";
      } elsif ($c =~ /[atcgn]/) {# mismatch in reverse strand
	die "Unexpected mismatch in rev at $_";
      } elsif ($c eq "+") {# insertion - ,+2cc,
	my $ds = $i + 1;
	$i += 2;
	my $c2 = substr $F[4], $i, 1;
	while ($c2 =~ /\d/) {
	  $i += 1;
	  $c2 = substr $F[4], $i, 1;
	}
	my $nb = substr $F[4], $ds, $i - $ds;
	$i += $nb - 1;
      } elsif ($c eq "-") {# deletion - ,-2ta,
	my $ds = $i + 1;
	$i += 2;
	my $c2 = substr $F[4], $i, 1;
	while ($c2 =~ /\d/) {
	  $i += 1;
	  $c2 = substr $F[4], $i, 1;
	}
	my $nb = substr $F[4], $ds, $i - $ds;
	$i += $nb - 1;
      } else {
	die "Unkown read base: $c";
      }
      $i += 1;
    }
    next unless $nbA + $nbG >= 10;
    my @A = ( $F[0], $F[1], uc($F[2]), $nbA, $nbG, $nbA + $nbG, $nbStart, $nbStop );
    if (defined $M[$F[1] - 1]) {
      my $h = $M[$F[1] - 1];
      for my $s ( 'kind', 'aa', 'frame', 'context', 'donor', 'acceptor', 'gene' ) {
	if (defined $h->{$s}) {
	  push @A, $h->{$s};
	} else {
	  push @A, "NA";
	}
      }
    } else {
      push @A, "NA", "NA", "NA", "NA", "NA", "NA", "NA";
    }
    print join("\t", @A), "\n";
  }
  close FD;
}

sub analyze {
  my ($s) = @_;
  $s =~ s/^(\S+)\s+(\S+)\s+//;
  my $kind = $1;
  my $pos = $2;
  die "grmp $s" unless defined $pos;
  my $strand = "+";
  $strand = "-" if $pos =~ s/^complement\((.*)\)$/$1/;
  my @E;
  my @P1;
  my @P2;
  if ($pos =~ s/^join\((.*)\)$/$1/) {
    @E = split /,/, $pos;
  } else {
    push @E, $pos;
  }
  foreach my $e (@E) {
    my ($p1, $p2) = $e =~ /^<?(\d+)\.\.>?(\d+)$/;
    unless (defined $p2) {
      return if $pos =~ /^order/; # some fly genes come from both strands... need to look into this at some point
      return if $pos =~ /^complement/; # same - e.g. chr3R
      die "grmp $e '$pos'" unless $e =~ /^>?\d+$/;
      $p1 = $e;
      $p2 = $e;
    }
    push @P1, $p1;
    push @P2, $p2;
  }
  if ($kind eq "CDS") {
    my $gene;
    my $pep = "";
    if ($s =~ /\/gene="([^"]+)"/) {
      $gene = $1;
    }
    if ($s =~ s/ \/translation="([^"]+)"//) {
      $pep = $1;
    }
    if ($strand eq "+") {
      die "grmp $P1[0]" if $P1[0] < 4;
      my $rna = substr $seq, $P1[0] - 4, 3;
      for my $i (0 .. $#P1) {
	$rna .= substr $seq, $P1[$i] - 1, $P2[$i] - $P1[$i] + 1;
      }
      $rna .= substr $seq, $P2[$#P2], 3;
      my $curExon = 0;
      my $p1 = $P1[$curExon] - 1;
      my $p2 = $P2[$curExon] - 1;
      my $i = $p1;
      my $p = 0;
      my $r = 3;
      while ($p < length($pep)) {
	#substr $seqP, $i, 1, "[" if substr($seqP, $i, 1) eq " ";
	my $nt = substr $rna, $r, 1;
	if ($nt eq "A" and (not defined($P[$i]) or $P[$i]->{'kind'} ne "CDS")) {
	  $P[$i] = {};
	  $P[$i]->{'kind'} = "CDS";
	  $P[$i]->{'aa'} = substr $pep, $p, 1;
	  $P[$i]->{'frame'} = 0;
	  $P[$i]->{'context'} = substr $rna, $r - 3, 7;
	  $P[$i]->{'donor'} = $p2 - $i if $curExon < $#P1 and $p2 - $i < 3;
	  $P[$i]->{'acceptor'} = $i - $p1 if $curExon > 0 and $i - $p1 < 3;
	  $P[$i]->{'gene'} = $gene if defined $gene;
	}
	$i += 1;
	$r += 1;
	if ($i > $p2) {
	  $curExon += 1;
	  last if $curExon > $#P1;
	  $p1 = $P1[$curExon] - 1;
	  $p2 = $P2[$curExon] - 1;
	  $i = $p1;
	}
	$nt = substr $rna, $r, 1;
	if ($nt eq "A" and (not defined($P[$i]) or $P[$i]->{'kind'} ne "CDS")) {
	  $P[$i] = {};
	  $P[$i]->{'kind'} = "CDS";
	  $P[$i]->{'aa'} = substr $pep, $p, 1;
	  $P[$i]->{'frame'} = 1;
	  $P[$i]->{'context'} = substr $rna, $r - 3, 7;
	  $P[$i]->{'donor'} = $p2 - $i if $curExon < $#P1 and $p2 - $i < 3;
	  $P[$i]->{'acceptor'} = $i - $p1 if $curExon > 0 and $i - $p1 < 3;
	  $P[$i]->{'gene'} = $gene if defined $gene;
	}
	$i += 1;
	$r += 1;
	if ($i > $p2) {
	  $curExon += 1;
	  last if $curExon > $#P1;
	  $p1 = $P1[$curExon] - 1;
	  $p2 = $P2[$curExon] - 1;
	  $i = $p1;
	}
	#substr $seqP, $i, 1, ">" if substr($seqP, $i, 1) eq " ";
	$nt = substr $rna, $r, 1;
	if ($nt eq "A" and (not defined($P[$i]) or $P[$i]->{'kind'} ne "CDS")) {
	  $P[$i] = {};
	  $P[$i]->{'kind'} = "CDS";
	  $P[$i]->{'aa'} = substr $pep, $p, 1;
	  $P[$i]->{'frame'} = 2;
	  $P[$i]->{'context'} = substr $rna, $r - 3, 7;
	  $P[$i]->{'donor'} = $p2 - $i if $curExon < $#P1 and $p2 - $i < 3;
	  $P[$i]->{'acceptor'} = $i - $p1 if $curExon > 0 and $i - $p1 < 3;
	  $P[$i]->{'gene'} = $gene if defined $gene;
	}
	$i += 1;
	$r += 1;
	if ($i > $p2) {
	  $curExon += 1;
	  last if $curExon > $#P1;
	  $p1 = $P1[$curExon] - 1;
	  $p2 = $P2[$curExon] - 1;
	  $i = $p1;
	}
	$p += 1;
      }
    } else {
      die "grmp $P1[0]" if $P1[0] < 4;
      my $rna = substr $seq, $P1[0] - 4, 3;
      for my $i (0 .. $#P1) {
	$rna .= substr $seq, $P1[$i] - 1, $P2[$i] - $P1[$i] + 1;
      }
      $rna .= substr $seq, $P2[$#P2], 3;
      $rna = reverse $rna;
      $rna =~ tr/ACGT/TGCA/;
      my $curExon = $#P1;
      my $p1 = $P1[$curExon] - 1;
      my $p2 = $P2[$curExon] - 1;
      my $i = $p2;
      my $p = 0;
      my $r = 3;
      while ($p < length($pep)) {
	#substr $seqM, $i, 1, "]" if substr($seqM, $i, 1) eq " ";
	my $nt = substr $rna, $r, 1;
	if ($nt eq "A" and (not defined($M[$i]) or $M[$i]->{'kind'} ne "CDS")) {
	  $M[$i] = {};
	  $M[$i]->{'kind'} = "CDS";
	  $M[$i]->{'aa'} = substr $pep, $p, 1;
	  $M[$i]->{'frame'} = 0;
	  $M[$i]->{'context'} = substr $rna, $r - 3, 7;
	  $M[$i]->{'donor'} = $i - $p1 if $curExon > 0 and $i - $p1 < 3;
	  $M[$i]->{'acceptor'} = $p2 - $i if $curExon < $#P1 and $p2 - $i < 3;
	  $M[$i]->{'gene'} = $gene if defined $gene;
	}
	$i -= 1;
	$r += 1;
	if ($i < $p1) {
	  $curExon -= 1;
	  last if $curExon < 0;
	  $p1 = $P1[$curExon] - 1;
	  $p2 = $P2[$curExon] - 1;
	  $i = $p2;
	}
	#substr $seqM, $i, 1, substr($pep, $p, 1) if substr($seqM, $i, 1) eq " ";
	$nt = substr $rna, $r, 1;
	if ($nt eq "A" and (not defined($M[$i]) or $M[$i]->{'kind'} ne "CDS")) {
	  $M[$i] = {};
	  $M[$i]->{'kind'} = "CDS";
	  $M[$i]->{'aa'} = substr $pep, $p, 1;
	  $M[$i]->{'frame'} = 1;
	  $M[$i]->{'context'} = substr $rna, $r - 3, 7;
	  $M[$i]->{'donor'} = $i - $p1 if $curExon > 0 and $i - $p1 < 3;
	  $M[$i]->{'acceptor'} = $p2 - $i if $curExon < $#P1 and $p2 - $i < 3;
	  $M[$i]->{'gene'} = $gene if defined $gene;
	}
	$i -= 1;
	$r += 1;
	if ($i < $p1) {
	  $curExon -= 1;
	  last if $curExon < 0;
	  $p1 = $P1[$curExon] - 1;
	  $p2 = $P2[$curExon] - 1;
	  $i = $p2;
	}
	#substr $seqM, $i, 1, "<" if substr($seqM, $i, 1) eq " ";
	$nt = substr $rna, $r, 1;
	if ($nt eq "A" and (not defined($M[$i]) or $M[$i]->{'kind'} ne "CDS")) {
	  $M[$i] = {};
	  $M[$i]->{'kind'} = "CDS";
	  $M[$i]->{'aa'} = substr $pep, $p, 1;
	  $M[$i]->{'frame'} = 2;
	  $M[$i]->{'context'} = substr $rna, $r - 3, 7;
	  $M[$i]->{'donor'} = $i - $p1 if $curExon > 0 and $i - $p1 < 3;
	  $M[$i]->{'acceptor'} = $p2 - $i if $curExon < $#P1 and $p2 - $i < 3;
	  $M[$i]->{'gene'} = $gene if defined $gene;
	}
	$i -= 1;
	$r += 1;
	if ($i < $p1) {
	  $curExon -= 1;
	  last if $curExon < 0;
	  $p1 = $P1[$curExon] - 1;
	  $p2 = $P2[$curExon] - 1;
	  $i = $p2;
	}
	$p += 1;
      }
    }
  }
  if ($kind eq "mRNA" or $kind eq "misc_RNA" or $kind eq "ncRNA" or $kind eq "precursor_RNA" or $kind eq "rRNA" or $kind eq "tRNA") {
    my $gene;
    if ($s =~ /\/gene="([^"]+)"/) {
      $gene = $1;
    }
    if ($strand eq "+") {
      die "grmp $P1[0]" if $P1[0] < 4;
      my $rna = substr $seq, $P1[0] - 4, 3;
      for my $i (0 .. $#P1) {
	$rna .= substr $seq, $P1[$i] - 1, $P2[$i] - $P1[$i] + 1;
      }
      $rna .= substr $seq, $P2[$#P2], 3;
      my $curExon = 0;
      my $p1 = $P1[$curExon] - 1;
      my $p2 = $P2[$curExon] - 1;
      my $i = $p1;
      my $r = 3;
      while ($r < (length($rna) - 3)) {
	my $nt = substr $rna, $r, 1;
	if ($nt eq "A" and not defined($P[$i])) {
	  $P[$i] = {};
	  $P[$i]->{'kind'} = $kind;
	  $P[$i]->{'context'} = substr $rna, $r - 3, 7;
	  $P[$i]->{'donor'} = $p2 - $i if $curExon < $#P1 and $p2 - $i < 3;
	  $P[$i]->{'acceptor'} = $i - $p1 if $curExon > 0 and $i - $p1 < 3;
	  $P[$i]->{'gene'} = $gene if defined $gene;
	}
	$i += 1;
