# syntax=docker/dockerfile:1

# Scientific Python / data-science image
# Slim Debian base with a modern CPython. Most packages ship manylinux wheels,
# but pyranges pulls in `sorted_nearest`, a C extension with no wheel, so a
# compiler is needed at build time. We install build tools, compile, then purge
# them in the same layer to keep the final image slim.
FROM python:3.12-slim-bookworm

# ---- Environment -----------------------------------------------------------
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MPLBACKEND=Agg

# ---- Runtime system dependencies -------------------------------------------
# libgomp1  -> OpenMP runtime used by scikit-learn / scipy
# libglib2.0-0, libgl1 -> commonly needed by matplotlib / plotting backends
# fonts + curl/ca-certificates -> nicer plots and TLS
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        libgomp1 \
        libglib2.0-0 \
        libgl1 \
        fonts-dejavu-core \
        curl \
        ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# ---- Python packages --------------------------------------------------------
# Install build tools (needed to compile sorted_nearest for pyranges), install
# all packages, then purge the build tools in the same layer. The compiled
# extension already lives in site-packages, so it survives the purge.
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential python3-dev \
 && python -m pip install --upgrade pip setuptools wheel \
 && pip install \
        numpy \
        scipy \
        pandas \
        polars \
        pyarrow \
        scikit-learn \
        statsmodels \
        matplotlib \
        seaborn \
        pyranges \
        upsetplot \
        joblib \
        tqdm \
 && apt-get purge -y --auto-remove build-essential python3-dev \
 && rm -rf /var/lib/apt/lists/*

# ---- Sanity check -----------------------------------------------------------
# Fails the build early if any package can't be imported.
RUN python - <<'PY'
import importlib
mods = [
    "numpy", "scipy", "pandas", "polars", "pyarrow",
    "sklearn", "statsmodels", "matplotlib", "seaborn",
    "pyranges", "upsetplot", "joblib", "tqdm",
]
for m in mods:
    importlib.import_module(m)
    print(f"ok: {m}")
print("All imports succeeded.")
PY

# ---- Workspace --------------------------------------------------------------
WORKDIR /work

CMD ["python"]