    output:
        os.path.join(ANALYSIS_DIR, "threshold_sweep.pdf"),
    params:
        datasets = lambda wildcards, input: " ".join(
            f"--dataset {name} {path}"
            for name, path in zip(_nvi_by_name.keys(), input)
        ),
    resources:
        mem_mb  = 64 * 1024,
        runtime = 2 * 60,
    conda:
        "envs/base.yml"
    shell:
        """
        python {SCRIPTS_DIR}/plot_threshold_sweep.py \
            {params.datasets} \
            --output-pdf {output}
        """


