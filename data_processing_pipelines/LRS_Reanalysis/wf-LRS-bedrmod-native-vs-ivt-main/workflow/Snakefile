rule filter_sites:
    input:
        os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_fisher.bed.gz"),
    output:
        bed    = os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_fisher.filtered.bed"),
        counts = os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_fisher.filter_counts.tsv"),
    params:
        min_log2fc           = lambda wildcards: config["FINAL_FILTER"][wildcards.name]["min_log2fc"],
        max_padj             = lambda wildcards: config["FINAL_FILTER"][wildcards.name]["max_padj"],
        min_ivt_absent_score = lambda wildcards: config["FINAL_FILTER"][wildcards.name]["min_ivt_absent_score"],
        min_native_freq      = lambda wildcards: config["FINAL_FILTER"][wildcards.name]["min_native_freq"],
    resources:
        mem_mb  = 16 * 1024,
        runtime = 30,
    conda:
        "envs/base.yml"
    shell:
        """
        python {SCRIPTS_DIR}/filter_sites.py \
            --min-log2fc           {params.min_log2fc} \
            --max-padj             {params.max_padj} \
            --min-ivt-absent-score {params.min_ivt_absent_score} \
            --min-native-freq      {params.min_native_freq} \
            --output-counts        {output.counts} \
            -o {output.bed} \
            {input}
        """


rule proximity_filter:
    input:
        os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_fisher.filtered.bed.gz"),
    output:
        bed    = os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_fisher.filtered.deduped.bed"),
        counts = os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_fisher.dedup_counts.tsv"),
    params:
        max_proximity = lambda wildcards: config["PROXIMITY_FILTER"][wildcards.name]["max_proximity"],
    resources:
        mem_mb  = 4 * 1024,
        runtime = 10,
    conda:
        "envs/base.yml"
    shell:
        """
        python {SCRIPTS_DIR}/proximity_filter.py \
            --max-proximity {params.max_proximity} \
            --output-counts {output.counts} \
            -o {output.bed} \
            {input}
        """


rule swap_scores:
    """Visualisation copy: score <- -log10(padj), original score -> red colour."""
    input:
        os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_fisher.filtered.bed.gz"),
    output:
        os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_fisher.filtered.scores_swapped.bed"),
    resources:
        mem_mb  = 8 * 1024,
        runtime = 30,
    conda:
        "envs/base.yml"
    shell:
        """
        python {SCRIPTS_DIR}/swap_scores.py {input} -o {output}
        """


rule plot_filtered_scatter:
    input:
        os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_fisher.filtered.bed.gz"),
    output:
        os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_fisher.filtered_scatter.pdf"),
    params:
        colors = " ".join(
            f"--color '{mod}' '{color}'"
            for mod, color in config["MODIFICATION_COLORS"].items()
        ),
        score_thr      = lambda wildcards: config["FINAL_FILTER"][wildcards.name]["min_ivt_absent_score"],
        log2fc_thr     = lambda wildcards: config["FINAL_FILTER"][wildcards.name]["min_log2fc"],
    resources:
        mem_mb  = 16 * 1024,
        runtime = 30,
    conda:
        "envs/base.yml"
    shell:
        """
        python {SCRIPTS_DIR}/plot_filtered_scatter.py \
            --input              {input} \
            --name               {wildcards.name} \
            --score-threshold    {params.score_thr} \
            --log2fc-threshold   {params.log2fc_thr} \
            {params.colors} \
            --output-pdf         {output}
        """


rule ivt_site_counts:
    """Total IVT sites per modification from the sanitized IVT BED."""
    input:
        lambda wildcards: _sanitized(wildcards.name, "ivt"),
    output:
        os.path.join(ANALYSIS_DIR, "{name}.ivt_counts.tsv"),
    resources:
        mem_mb  = 2 * 1024,
        runtime = 20,
    shell:
        r"""
        ( printf 'modification\tivt_total\n'; \
          awk -F'\t' '!/^#/ && NF > 5 {{ c[$4]++ }} END {{ for (m in c) print m"\t"c[m] }}' {input} \
            | sort -k1,1 ) > {output}
        """


rule supplementary_filter_table:
    input:
        filter_counts = expand(
            os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_fisher.filter_counts.tsv"),
            name=_nvi_by_name.keys(),
        ),
        ivt_counts = expand(
            os.path.join(ANALYSIS_DIR, "{name}.ivt_counts.tsv"),
            name=_nvi_by_name.keys(),
        ),
    output:
        os.path.join(ANALYSIS_DIR, "supplementary_filter_counts.xlsx"),
    params:
        datasets = lambda wildcards, input: " ".join(
            f"--dataset {name} {path}"
            for name, path in zip(_nvi_by_name.keys(), input.filter_counts)
        ),
        ivt_datasets = lambda wildcards, input: " ".join(
            f"--ivt-counts {name} {path}"
            for name, path in zip(_nvi_by_name.keys(), input.ivt_counts)
        ),
    resources:
        mem_mb  = 4 * 1024,
        runtime = 10,
    conda: "envs/base.yml"
    shell:
        """
        python {SCRIPTS_DIR}/build_filter_table.py \
            {params.datasets} \
            {params.ivt_datasets} \
            -o {output}
        """


rule supplementary_filter_table_deduped:
    input:
        filter_counts = expand(
            os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_fisher.filter_counts.tsv"),
            name=_nvi_by_name.keys(),
        ),
        dedup_counts = expand(
            os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_fisher.dedup_counts.tsv"),
            name=_nvi_by_name.keys(),
        ),
        ivt_counts = expand(
            os.path.join(ANALYSIS_DIR, "{name}.ivt_counts.tsv"),
            name=_nvi_by_name.keys(),
        ),
    output:
        os.path.join(ANALYSIS_DIR, "supplementary_filter_counts_deduped.xlsx"),
    params:
        datasets = lambda wildcards, input: " ".join(
            f"--dataset {name} {path}"
            for name, path in zip(_nvi_by_name.keys(), input.filter_counts)
        ),
        dedup_datasets = lambda wildcards, input: " ".join(
            f"--dedup-counts {name} {path}"
            for name, path in zip(_nvi_by_name.keys(), input.dedup_counts)
        ),
        ivt_datasets = lambda wildcards, input: " ".join(
            f"--ivt-counts {name} {path}"
            for name, path in zip(_nvi_by_name.keys(), input.ivt_counts)
        ),
    resources:
        mem_mb  = 4 * 1024,
        runtime = 10,
    conda: "envs/base.yml"
    shell:
        """
        python {SCRIPTS_DIR}/build_filter_table.py \
            {params.datasets} \
            {params.dedup_datasets} \
            {params.ivt_datasets} \
            -o {output}
        """


rule illumina_validation:
    input:
        unfiltered = os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_fisher.bed.gz"),
        filtered   = os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_fisher.filtered.bed.gz"),
        illumina   = config["ILLUMINA_VALIDATION"]["bed"],
    output:
        os.path.join(ANALYSIS_DIR, "{name}.illumina_validation.pdf"),
    params:
        colors = " ".join(
            f"--color '{mod}' '{color}'"
            for mod, color in config["MODIFICATION_COLORS"].items()
        ),
        min_cov = lambda wildcards: (
            config["NATIVE_VS_IVT"]["data"][
                [r[0] for r in config["NATIVE_VS_IVT"]["data"]].index(wildcards.name)
            ][3]
        ),
    resources:
        mem_mb  = 32 * 1024,
        runtime = 30,
    conda:
        "envs/base.yml"
    shell:
        """
        python {SCRIPTS_DIR}/plot_illumina_validation.py \
            --unfiltered          {input.unfiltered} \
            --filtered            {input.filtered} \
            --illumina            {input.illumina} \
            --name                {wildcards.name} \
            --min-native-coverage {params.min_cov} \
            {params.colors} \
            --output-pdf {output}
        """
