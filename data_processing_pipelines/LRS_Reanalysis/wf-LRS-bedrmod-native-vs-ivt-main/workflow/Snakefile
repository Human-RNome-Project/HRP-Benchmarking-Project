import os

#### load config ####
if "--configfile" in sys.argv:
    i = sys.argv.index("--configfile")
    config_path = sys.argv[i + 1]
    configfile: config_path
else:
    config_path = "config/config.yml"
    configfile: config_path

ANALYSIS_DIR = config["ANALYSIS_DIR"]
SCRIPTS_DIR  = config["SCRIPTS_DIR"]

_nvi_cfg     = config["NATIVE_VS_IVT"]
_nvi_by_name = {
    row[0]: dict(zip(_nvi_cfg["header"], row))
    for row in _nvi_cfg["data"]
}

def _sanitized(name, side):
    return os.path.join(ANALYSIS_DIR, "sanitized", f"{name}_{side}.bed")


def _coverage_dist_opts(wildcards):
    """Threshold line + x-axis floor, only for the coverage distribution."""
    if wildcards.column != "coverage":
        return ""
    name, side = wildcards.stem.rsplit("_", 1)
    thr = _nvi_by_name[name][f"min_{side}_coverage"]
    return f"--vline {thr} --xmin 1"

# stem -> raw path  (e.g. "polyA_native" -> "raw/polyA_native_merged...bed")
# stem -> sanitized path  (e.g. "polyA_native" -> "analysis/sanitized/polyA_native.bed")
_raw_input_paths = {}
_dist_files      = {}
for _name, _e in _nvi_by_name.items():
    for _side, _key in (("native", "native_path"), ("ivt", "ivt_path")):
        _stem = f"{_name}_{_side}"
        _raw_input_paths[_stem] = _e[_key]
        _dist_files[_stem]      = _sanitized(_name, _side)


include: "rules/samtools.smk"


#### rules ####

rule all:
    input:
        expand(
            os.path.join(ANALYSIS_DIR, "{stem}.{column}_dist.{ext}"),
            stem=_dist_files.keys(),
            column=config["PLOT_COLUMNS"],
            ext=["tsv", "pdf"],
        ),
        expand(
            os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_fisher.bed.gz"),
            name=_nvi_by_name.keys(),
        ),
        expand(
            os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_pvalue_dist.{ext}"),
            name=_nvi_by_name.keys(),
            ext=["tsv", "pdf"],
        ),
        expand(
            os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt.{column}_scatter.{ext}"),
            name=_nvi_by_name.keys(),
            column=config["PLOT_COLUMNS"],
            ext=["pdf", "tsv"],
        ),
        os.path.join(ANALYSIS_DIR, "threshold_sweep.pdf"),
        expand(
            os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_volcano.{ext}"),
            name=_nvi_by_name.keys(),
            ext=["pdf", "tsv"],
        ),
        expand(
            os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_score_density.pdf"),
            name=_nvi_by_name.keys(),
        ),
        expand(
            os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_fisher.filtered.bed.gz"),
            name=_nvi_by_name.keys(),
        ),
        expand(
            os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_fisher.filtered.deduped.bed.gz"),
            name=_nvi_by_name.keys(),
        ),
        expand(
            os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_fisher.filtered.scores_swapped.bed.gz"),
            name=_nvi_by_name.keys(),
        ),
        expand(
            os.path.join(ANALYSIS_DIR, "{variant}_summary.pdf"),
            variant=["filtered", "filtered.deduped"],
        ),
        os.path.join(ANALYSIS_DIR, "supplementary_filter_counts.xlsx"),
        os.path.join(ANALYSIS_DIR, "supplementary_filter_counts_deduped.xlsx"),
        expand(
            os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_fisher.filtered_scatter.pdf"),
            name=_nvi_by_name.keys(),
        ),
        expand(
            os.path.join(ANALYSIS_DIR, "{name}.illumina_validation.pdf"),
            name=_nvi_by_name.keys(),
        ),


rule sanitize_bedrmod:
    input:
        lambda wildcards: _raw_input_paths[wildcards.stem],
    output:
        os.path.join(ANALYSIS_DIR, "sanitized", "{stem}.bed"),
    params:
        drop_chroms = " ".join(
            f"--drop-chroms {c}"
            for c in config.get("SANITIZE", {}).get("drop_chroms", [])
        ),
    conda:
        "envs/base.yml"
    shell:
        "python {SCRIPTS_DIR}/sanitize_bedrmod.py {params.drop_chroms} {input} {output}"


rule plot_bedrmod_col_distribution:
    input:
        lambda wildcards: _dist_files[wildcards.stem],
    output:
        tsv = os.path.join(ANALYSIS_DIR, "{stem}.{column}_dist.tsv"),
        pdf = os.path.join(ANALYSIS_DIR, "{stem}.{column}_dist.pdf"),
    params:
        colors = " ".join(
            f"--color '{mod}' '{color}'"
            for mod, color in config["MODIFICATION_COLORS"].items()
        ),
        cov_opts = lambda wildcards: _coverage_dist_opts(wildcards),
    resources:
        mem_mb  = 32 * 1024,
        runtime = 2 * 60,
    conda:
        "envs/base.yml"
    shell:
        """
        python {SCRIPTS_DIR}/plot_bedrmod_col_distribution.py \
            --column     {wildcards.column} \
            {params.colors} \
            {params.cov_opts} \
            --output-tsv {output.tsv} \
            --output-pdf {output.pdf} \
            {input}
        """


rule native_vs_ivt_fisher:
    input:
        native = lambda wildcards: _sanitized(wildcards.name, "native"),
        ivt    = lambda wildcards: _sanitized(wildcards.name, "ivt"),
    output:
        temp(os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt_fisher.bed")),
    params:
        min_native_cov = lambda wildcards: int(_nvi_by_name[wildcards.name]["min_native_coverage"]),
        min_ivt_cov    = lambda wildcards: int(_nvi_by_name[wildcards.name]["min_ivt_coverage"]),
    resources:
        mem_mb  = 64 * 1024,
        runtime = 8 * 60,
    conda:
        "envs/base.yml"
    shell:
        """
        python {SCRIPTS_DIR}/compare_native_vs_ivt.py \
            --min-native-coverage {params.min_native_cov} \
            --min-ivt-coverage    {params.min_ivt_cov} \
            -o {output} \
            {input.native} \
            {input.ivt}
        """



rule native_vs_ivt_scatter:
    input:
        native = lambda wildcards: _sanitized(wildcards.name, "native"),
        ivt    = lambda wildcards: _sanitized(wildcards.name, "ivt"),
    output:
        pdf = os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt.{column}_scatter.pdf"),
        tsv = os.path.join(ANALYSIS_DIR, "{name}.native_vs_ivt.{column}_scatter.tsv"),
    params:
        min_native_cov = lambda wildcards: int(_nvi_by_name[wildcards.name]["min_native_coverage"]),
        min_ivt_cov    = lambda wildcards: int(_nvi_by_name[wildcards.name]["min_ivt_coverage"]),
    resources:
        mem_mb  = 32 * 1024,
        runtime = 2 * 60,
    conda:
        "envs/base.yml"
    shell:
        """
        python {SCRIPTS_DIR}/plot_native_vs_ivt_scatter.py \
            --column                {wildcards.column} \
            --min-native-coverage   {params.min_native_cov} \
            --min-ivt-coverage      {params.min_ivt_cov} \
            --output-pdf            {output.pdf} \
            --output-tsv            {output.tsv} \
            {input.native} \
            {input.ivt}
        """


rule threshold_sweep:
