        colors   = " ".join(
            f"--color '{mod}' '{color}'"
            for mod, color in config["MODIFICATION_COLORS"].items()
        ),
    resources:
        mem_mb  = 32 * 1024,
        runtime = 2 * 60,
    conda:
        "envs/base.yml"
    shell:
        """
        python {SCRIPTS_DIR}/plot_score_density.py \
            --sig-padj   {params.sig_padj} \
            {params.colors} \
            --output-pdf {output} \
            {input.fisher} \
            {input.ivt}
        """


